<!DOCTYPE html>
<html>
  <head>
    <title>Mecânico - Oficina Royal Enfield</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Tags de segurança e configuração do Rails %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Importa o CSS principal da aplicação e o Bootstrap %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
    <!-- Navbar Mecânico -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <%= link_to "🔧 Mecânico - Royal Enfield", mechanic_dashboard_path, class: "navbar-brand" %>
        <%# Botão para menu colapsável em telas menores %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMecanico">
          <span class="navbar-toggler-icon"></span>
        </button>
        <%# Itens do menu de navegação %>
        <div class="collapse navbar-collapse" id="navbarMecanico">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Dashboard", mechanic_dashboard_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Agendamentos", mechanic_schedulings_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Minhas Revisões", mechanic_reviews_path, class: "nav-link" %>
            </li>
          </ul>
          <%# Menu lateral direito com link para o site e dropdown de usuário %>
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "Ver Site", root_path, class: "nav-link", target: "_blank" %>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <%= current_user.name %>
              </a>
              <ul class="dropdown-menu">
                <li><%= button_to "Sair", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <%# Conteúdo Principal - O conteúdo dinâmico das páginas é inserido aqui através do yield. %>
    <main class="container-fluid my-4">
      <%= yield %>
    </main>
    <%# Scripts - Importa o bundle JavaScript do Bootstrap (necessário para o menu colapsável e alertas %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>